rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ── Students ──────────────────────────────────────────────────────────
    // Public read is needed for the Smart Finder. Writes are owner-only:
    // the app signs in with a custom token whose uid is 'student_<admNo>'.

    match /students/{admissionNumber} {
      allow read: if true;

      allow create: if request.auth != null
        && (request.auth.uid == 'student_' + admissionNumber
            || request.auth.token.admissionNumber == admissionNumber);

      allow update: if request.auth != null
        && (request.auth.uid == 'student_' + admissionNumber
            || request.auth.token.admissionNumber == admissionNumber);

      allow delete: if false;

      // Subcollections: portalData is written by the sync engine (Admin SDK,
      // bypasses rules). customProfile and other client subcollections are
      // owner-only for writes, public for reads (finder + public showcase).
      match /{document=**} {
        allow read: if true;
        allow create, update: if request.auth != null
          && (request.auth.uid == 'student_' + admissionNumber
              || request.auth.token.admissionNumber == admissionNumber);
        allow delete: if false;
      }
    }

    match /students_by_name/{studentName} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /rankings/{batchId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Reference data (MAC Exam Hub) ─────────────────────────────────────
    // Public read, Cloud Functions / Admin SDK only write.

    match /departments/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /batches/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /divisions/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /portalDataCache/{admissionNumber} {
      allow read: if true;
      allow write: if false;
    }

    match /academicCalendar/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Notification Preferences — owner only ─────────────────────────────

    match /notificationPrefs/{admissionNumber} {
      allow read, write: if request.auth != null
                         && (request.auth.uid == 'student_' + admissionNumber || request.auth.token.admissionNumber == admissionNumber);
    }

    // ── Scrape Logs — no client access, Cloud Functions only ──────────────

    match /scrapeLogs/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Community Chat ────────────────────────────────────────────────────
    // Public read/write; enforces text length limit and required fields.

    match /chat_messages/{msgId} {
      allow read: if true;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && (
                      (request.resource.data.author is string && request.resource.data.author.size() > 0)
                      ||
                      (request.resource.data.anonHandle is string && request.resource.data.anonHandle.size() > 0)
                    );
      allow update, delete: if false;
    }

    // ── Notifications & Events (Admin Communication) ──────────────────────
    // Public read. Writes require a signed-in user (admin posts via the app
    // while signed in with a custom token). Previously: allow write if true.

    match /notifications/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }

}
